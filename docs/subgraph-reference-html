<script>
const SVG_NS = 'http://www.w3.org/2000/svg';

function endpointOnCircle(cx, cy, r, tx, ty) {
  const dx = tx - cx, dy = ty - cy;
  const len = Math.hypot(dx, dy);
  if (len < 0.001) return { x: cx, y: cy };
  return { x: cx + (dx / len) * r, y: cy + (dy / len) * r };
}

function drawCurvedEdge(svg, fromNode, toNode, opts) {
  const { color, width, opacity, marker, curveAmt = 0, dashed = false } = opts;
  const fromR = fromNode.r || 14;
  const toR = toNode.r || 14;
  const dx = toNode.x - fromNode.x, dy = toNode.y - fromNode.y;
  const len = Math.hypot(dx, dy);
  const midX = (fromNode.x + toNode.x) / 2, midY = (fromNode.y + toNode.y) / 2;
  const perpX = -dy / len, perpY = dx / len;
  const ctrlX = midX + perpX * curveAmt;
  const ctrlY = midY + perpY * curveAmt;
  const fromTarget = curveAmt !== 0 ? { x: ctrlX, y: ctrlY } : { x: toNode.x, y: toNode.y };
  const toSource   = curveAmt !== 0 ? { x: ctrlX, y: ctrlY } : { x: fromNode.x, y: fromNode.y };
  const p1 = endpointOnCircle(fromNode.x, fromNode.y, fromR + 2, fromTarget.x, fromTarget.y);
  const p2 = endpointOnCircle(toNode.x,   toNode.y,   toR + 7,   toSource.x,   toSource.y);
  const path = document.createElementNS(SVG_NS, 'path');
  const d = curveAmt !== 0
    ? `M ${p1.x} ${p1.y} Q ${ctrlX} ${ctrlY} ${p2.x} ${p2.y}`
    : `M ${p1.x} ${p1.y} L ${p2.x} ${p2.y}`;
  path.setAttribute('d', d);
  path.setAttribute('fill', 'none');
  path.setAttribute('stroke', color);
  path.setAttribute('stroke-width', width);
  path.setAttribute('opacity', opacity);
  if (dashed) path.setAttribute('stroke-dasharray', '6,4');
  path.setAttribute('marker-end', 'url(#' + marker + ')');
  svg.appendChild(path);
  const mid = curveAmt !== 0
    ? { x: 0.25 * p1.x + 0.5 * ctrlX + 0.25 * p2.x, y: 0.25 * p1.y + 0.5 * ctrlY + 0.25 * p2.y }
    : { x: midX, y: midY };
  return mid;
}

function bboxOverlap(a, b) {
  return !(a.x + a.w < b.x || b.x + b.w < a.x || a.y + a.h < b.y || b.y + b.h < a.y);
}

// FIX: range di distanze DIVERSO per callout (grandi, vanno lontano) e inline (piccole, vicine)
function placeLabel(midX, midY, labelW, labelH, occupied, rangeType) {
  const padding = 6;
  const directions = [
    {dx: 0, dy: -1}, {dx: 0, dy: 1}, {dx: -1, dy: 0}, {dx: 1, dy: 0},
    {dx: -0.7, dy: -0.7}, {dx: 0.7, dy: -0.7}, {dx: -0.7, dy: 0.7}, {dx: 0.7, dy: 0.7}
  ];
  // FIX CHIAVE: callout = range lungo, inline = range corto
  const distances = rangeType === 'callout'
    ? [55, 85, 115, 150, 190, 230]
    : [16, 26, 38, 52, 70];
  for (const dist of distances) {
    for (const dir of directions) {
      const cx = midX + dir.dx * dist;
      const cy = midY + dir.dy * dist;
      const bbox = { x: cx - labelW/2 - padding, y: cy - labelH/2 - padding, w: labelW + padding*2, h: labelH + padding*2 };
      let conflict = false;
      for (const occ of occupied) {
        if (bboxOverlap(bbox, occ)) { conflict = true; break; }
      }
      if (!conflict) {
        occupied.push(bbox);
        return { x: cx, y: cy };
      }
    }
  }
  return null;
}

function makeDefs(svg, markers) {
  const defs = document.createElementNS(SVG_NS, 'defs');
  markers.forEach(m => {
    defs.innerHTML += `
      <marker id="${m.id}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="${m.color}" opacity="${m.opacity || 1}"/>
      </marker>
    `;
  });
  svg.appendChild(defs);
}

function drawNode(svg, node) {
  const g = document.createElementNS(SVG_NS, 'g');
  g.setAttribute('transform', `translate(${node.x},${node.y})`);
  const c = document.createElementNS(SVG_NS, 'circle');
  c.setAttribute('r', node.r);
  c.setAttribute('fill', node.fill);
  c.setAttribute('stroke', node.stroke);
  c.setAttribute('stroke-width', 1.8);
  g.appendChild(c);
  const t1 = document.createElementNS(SVG_NS, 'text');
  t1.setAttribute('y', node.r + 14);
  t1.setAttribute('text-anchor', 'middle');
  t1.setAttribute('font-family', 'Inter, sans-serif');
  t1.setAttribute('font-size', '12.5');
  t1.setAttribute('font-weight', '600');
  t1.setAttribute('fill', '#0a0a0a');
  t1.textContent = node.main;
  g.appendChild(t1);
  const t2 = document.createElementNS(SVG_NS, 'text');
  t2.setAttribute('y', node.r + 27);
  t2.setAttribute('text-anchor', 'middle');
  t2.setAttribute('font-family', 'Inter, sans-serif');
  t2.setAttribute('font-size', '10');
  t2.setAttribute('fill', '#999');
  t2.textContent = node.sub;
  g.appendChild(t2);
  svg.appendChild(g);
}

function drawInlineLabel(svg, pos, text, color) {
  if (!pos) return;
  const t = document.createElementNS(SVG_NS, 'text');
  t.setAttribute('x', pos.x);
  t.setAttribute('y', pos.y);
  t.setAttribute('text-anchor', 'middle');
  t.setAttribute('font-family', 'Inter, sans-serif');
  t.setAttribute('font-size', '10');
  t.setAttribute('font-style', 'italic');
  t.setAttribute('font-weight', '500');
  t.setAttribute('fill', color || '#a0a0a0');
  t.textContent = text;
  svg.appendChild(t);
  const bb = t.getBBox();
  const bg = document.createElementNS(SVG_NS, 'rect');
  bg.setAttribute('x', bb.x - 3);
  bg.setAttribute('y', bb.y - 1);
  bg.setAttribute('width', bb.width + 6);
  bg.setAttribute('height', bb.height + 2);
  bg.setAttribute('fill', '#ffffff');
  bg.setAttribute('opacity', '0.92');
  svg.insertBefore(bg, t);
}

function drawCallout(svg, anchorX, anchorY, labelPos, num, mech, vol, isBridge) {
  if (!labelPos) return;
  const volColors = {
    H: { bg: '#fee2e2', fg: '#991b1b' },
