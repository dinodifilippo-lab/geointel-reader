    L: { bg: '#f0f0ef', fg: '#525252' }
  };
  const boxW = 140, boxH = 30;
  const bx = labelPos.x - boxW/2;
  const by = labelPos.y - boxH/2;
  const line = document.createElementNS(SVG_NS, 'line');
  line.setAttribute('x1', anchorX);
  line.setAttribute('y1', anchorY);
  line.setAttribute('x2', labelPos.x);
  line.setAttribute('y2', by + boxH/2);
  line.setAttribute('stroke', isBridge ? '#b06030' : '#9a9a98');
  line.setAttribute('stroke-width', 0.8);
  line.setAttribute('stroke-dasharray', '3,3');
  svg.appendChild(line);
  const rect = document.createElementNS(SVG_NS, 'rect');
  rect.setAttribute('x', bx);
  rect.setAttribute('y', by);
  rect.setAttribute('width', boxW);
  rect.setAttribute('height', boxH);
  rect.setAttribute('rx', 4);
  rect.setAttribute('fill', isBridge ? '#fdf5e6' : '#ffffff');
  rect.setAttribute('stroke', isBridge ? '#b06030' : '#0a0a0a');
  rect.setAttribute('stroke-width', 1.3);
  svg.appendChild(rect);
  const badge = document.createElementNS(SVG_NS, 'circle');
  badge.setAttribute('cx', bx + 15);
  badge.setAttribute('cy', by + boxH/2);
  badge.setAttribute('r', 9);
  badge.setAttribute('fill', isBridge ? '#b06030' : '#0a0a0a');
  svg.appendChild(badge);
  const bt = document.createElementNS(SVG_NS, 'text');
  bt.setAttribute('x', bx + 15);
  bt.setAttribute('y', by + boxH/2 + 3.5);
  bt.setAttribute('text-anchor', 'middle');
  bt.setAttribute('font-family', 'Inter, sans-serif');
  bt.setAttribute('font-size', '10');
  bt.setAttribute('font-weight', '700');
  bt.setAttribute('fill', '#ffffff');
  bt.textContent = num;
  svg.appendChild(bt);
  const lt = document.createElementNS(SVG_NS, 'text');
  lt.setAttribute('x', bx + 31);
  lt.setAttribute('y', by + boxH/2 + 3);
  lt.setAttribute('font-family', 'Inter, sans-serif');
  lt.setAttribute('font-size', '11');
  lt.setAttribute('font-weight', '600');
  lt.setAttribute('fill', '#0a0a0a');
  lt.textContent = mech;
  svg.appendChild(lt);
  if (vol) {
    const vc = volColors[vol];
    const pill = document.createElementNS(SVG_NS, 'rect');
    pill.setAttribute('x', bx + boxW - 24);
    pill.setAttribute('y', by + boxH/2 - 6);
    pill.setAttribute('width', 16);
    pill.setAttribute('height', 12);
    pill.setAttribute('rx', 6);
    pill.setAttribute('fill', vc.bg);
    svg.appendChild(pill);
    const vt = document.createElementNS(SVG_NS, 'text');
    vt.setAttribute('x', bx + boxW - 16);
    vt.setAttribute('y', by + boxH/2 + 3);
    vt.setAttribute('text-anchor', 'middle');
    vt.setAttribute('font-family', 'Inter, sans-serif');
    vt.setAttribute('font-size', '9');
    vt.setAttribute('font-weight', '700');
    vt.setAttribute('fill', vc.fg);
    vt.textContent = vol;
    svg.appendChild(vt);
  }
}

// FIX: bbox accurato per ogni nodo, includendo label sottostante stimata
function computeNodeBBox(node) {
  const mainLen = (node.main || '').length;
  const subLen = (node.sub || '').length;
  const maxTextW = Math.max(mainLen * 7.2, subLen * 6.2);
  const w = Math.max(node.r * 2, maxTextW);
  const h = node.r * 2 + 34; // cerchio + nome + sub
  return {
    x: node.x - w/2 - 6,
    y: node.y - node.r - 6,
    w: w + 12,
    h: h + 12
  };
}

