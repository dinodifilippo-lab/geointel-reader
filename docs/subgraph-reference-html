function renderGraph(svgId, nodes, edges, opts = {}) {
  const svg = document.getElementById(svgId);
  svg.innerHTML = '';
  makeDefs(svg, [
    { id: svgId + '-ar-r',  color: '#ef4444' },
    { id: svgId + '-ar-g',  color: '#10b981' },
    { id: svgId + '-ar-br', color: '#b06030' }
  ]);
  const nodeById = {};
  nodes.forEach(n => { nodeById[n.id] = n; });
  const occupied = [];
  // FIX: bbox nodi accurato
  nodes.forEach(n => { occupied.push(computeNodeBBox(n)); });
  if (opts.territories) {
    opts.territories.forEach(t => {
      occupied.push({ x: t.x, y: t.y, w: t.w, h: 30 });
    });
    opts.territories.forEach(t => {
      const rect = document.createElementNS(SVG_NS, 'rect');
      rect.setAttribute('x', t.x);
      rect.setAttribute('y', t.y);
      rect.setAttribute('width', t.w);
      rect.setAttribute('height', t.h);
      rect.setAttribute('rx', 8);
      rect.setAttribute('fill', t.fill);
      rect.setAttribute('stroke', t.stroke);
      rect.setAttribute('stroke-width', 1);
      rect.setAttribute('stroke-dasharray', '4,3');
      svg.appendChild(rect);
      const label = document.createElementNS(SVG_NS, 'text');
      label.setAttribute('x', t.x + 20);
      label.setAttribute('y', t.y + 22);
      label.setAttribute('font-family', 'Inter, sans-serif');
      label.setAttribute('font-size', '10');
      label.setAttribute('font-weight', '700');
      label.setAttribute('letter-spacing', '2');
      label.setAttribute('fill', t.labelColor);
      label.textContent = t.name.toUpperCase();
      svg.appendChild(label);
    });
  }
  const midpoints = [];
  edges.forEach((e) => {
    const fn = nodeById[e.from];
    const tn = nodeById[e.to];
    if (!fn || !tn) return;
    const isBridge = !!e.bridge;
    const color = isBridge ? '#b06030' : (e.pol < 0 ? '#ef4444' : '#10b981');
    const markerId = isBridge ? svgId + '-ar-br' : (e.pol < 0 ? svgId + '-ar-r' : svgId + '-ar-g');
    const width = 1 + e.w * 3.4;
    const opacity = isBridge ? 0.85 : (e.critical ? 0.9 : 0.55);
    const mid = drawCurvedEdge(svg, fn, tn, {
      color, width, opacity, marker: markerId, curveAmt: e.curve || 0, dashed: isBridge
    });
    midpoints.push({ edge: e, mid });
  });
  // Callout critici piazzati con range FAR
  midpoints.forEach(({ edge, mid }) => {
    if (!edge.critical) return;
    const pos = placeLabel(mid.x, mid.y, 140, 30, occupied, 'callout');
    drawCallout(svg, mid.x, mid.y, pos, edge.critical.num, edge.critical.mech, edge.critical.vol, !!edge.bridge);
  });
  // Inline label con range vicino
  midpoints.forEach(({ edge, mid }) => {
    if (edge.critical) return;
    const labelW = edge.label.length * 5.4 + 6;
    const labelH = 12;
    const pos = placeLabel(mid.x, mid.y, labelW, labelH, occupied, 'inline');
    drawInlineLabel(svg, pos, edge.label, edge.bridge ? '#8a5a35' : '#a0a0a0');
  });
  nodes.forEach(n => drawNode(svg, n));
}

renderGraph('svg-single', singleNodes, singleEdges);

